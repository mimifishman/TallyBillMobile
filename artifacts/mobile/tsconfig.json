{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      // Force every 'react' type lookup (including from third-party library
      // .d.ts files deep in the pnpm virtual store) onto this app's single
      // @types/react copy. Without this, packages like react-native-svg,
      // expo-linear-gradient, expo-blur, and gesture-handler resolve 'react'
      // to the untyped react JS package (their .pnpm dirs have no @types
      // link), so their class components lose the Component base type and
      // tsc reports ~100 TS2786/TS2607 "cannot be used as a JSX component"
      // errors.
      //
      // IMPORTANT: these must point at the .d.ts FILES, not the package
      // directories. Expo's Metro applies tsconfig `paths` at runtime too,
      // but skips any alias target ending in .d.ts — aliasing the directory
      // makes Metro bundle the types-only package and the app 500s with
      // "package specifies a `main` module field that could not be resolved".
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom/index.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
